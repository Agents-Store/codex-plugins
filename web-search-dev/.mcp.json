{
  "mcpServers": {
    "firecrawl": {
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env_vars": [
        "FIRECRAWL_API_TOKEN"
      ]
    },
    "exa": {
      "command": "npx",
      "args": [
        "-y",
        "exa-mcp-server"
      ],
      "env_vars": [
        "EXA_API_KEY"
      ]
    },
    "perplexity": {
      "command": "npx",
      "args": [
        "-y",
        "@perplexity-ai/mcp-server"
      ],
      "env_vars": [
        "PERPLEXITY_API_KEY"
      ]
    },
    "jina": {
      "type": "http",
      "url": "https://mcp.jina.ai/v1",
      "bearer_token_env_var": "JINA_API_KEY"
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "${CONTEXT7_API_KEY}"
      ]
    }
  }
}