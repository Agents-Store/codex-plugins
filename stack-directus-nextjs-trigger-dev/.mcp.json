{
  "mcpServers": {
    "directus": {
      "type": "http",
      "url": "${NEXT_PUBLIC_DIRECTUS_URL}/mcp",
      "http_headers": {
        "Authorization": "Bearer ${DIRECTUS_ADMIN_TOKEN}"
      }
    },
    "trigger-dev": {
      "command": "npx",
      "args": [
        "trigger.dev@latest",
        "mcp"
      ],
      "env_vars": [
        "TRIGGER_SECRET_KEY",
        "TRIGGER_API_URL"
      ]
    }
  }
}